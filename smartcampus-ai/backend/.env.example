# ============================================================
# SmartCampus AI — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# --- Application ---
APP_NAME=SmartCampus AI
APP_ENV=development
SECRET_KEY=
DEBUG=true

# --- Database ---
DATABASE_URL=sqlite:///./smartcampus.db

# --- SMTP / Email ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_FROM_NAME=SmartCampus AI
EMAIL_ENABLED=false

# --- Voice Agent ---
VOICE_AGENT_ID=-P2vKX2Tc3Zk_oW6XcnI
VOICE_AGENT_FALLBACK_ID=P2YJQU8i3wOC75sAJ3f

# --- JWT ---
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440
